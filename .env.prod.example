# Copy to .env on the server. Generate every secret: python -c "import secrets;print(secrets.token_urlsafe(32))"
ENV=prod
APP_DOMAIN=iam.example.com
KC_DOMAIN=sso.example.com
POSTGRES_USER=iamops
POSTGRES_PASSWORD=
POSTGRES_DB=iamops
KEYCLOAK_DB_PASSWORD=
DATABASE_URL=postgresql+psycopg2://iamops:<POSTGRES_PASSWORD>@postgres:5432/iamops
JWT_SECRET=
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_URL=http://keycloak:8080
LDAP_DOMAIN=meridian.local
LDAP_ADMIN_PASSWORD=
LDAP_URL=ldap://openldap:389
CONNECTORS=keycloak,ldap
SLA_SWEEP_MINUTES=15
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
