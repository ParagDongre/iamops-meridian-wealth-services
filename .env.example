# IAMOps Runtime Configuration
# ENV=dev | prod (prod enforces strong secrets and disables demo credential hints)
ENV="dev"
PORT="3000"
APP_URL="http://localhost:3000"

# Security Secrets (MUST be replaced with 32+ char random values in production)
JWT_SECRET="dev-iamops-local-jwt-secret-change-in-prod"
MFA_ENCRYPTION_KEY="dev-iamops-mfa-encryption-key-change-in-prod"

# Database Path (SQLite persistent file)
DATABASE_PATH="./data/iamops.db"

# Operations & SLA Background Sweep
SLA_SWEEP_MINUTES="5"
DISABLE_API_DOCS="false"

# Optional External Keycloak OIDC & Admin REST Integration
# Leave blank to use the built-in Meridian IdP & Directory engine
KEYCLOAK_URL=""
KEYCLOAK_REALM="meridian"
KEYCLOAK_CLIENT_ID="iamops-console"
KEYCLOAK_CLIENT_SECRET=""
KEYCLOAK_ADMIN_USER=""
KEYCLOAK_ADMIN_PASSWORD=""

# Optional External OpenLDAP Bridge
LDAP_URL=""
LDAP_BASE_DN="dc=meridian,dc=internal"
LDAP_BIND_DN=""
LDAP_BIND_PASSWORD=""
